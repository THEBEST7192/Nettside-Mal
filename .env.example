# Lokalt utviklingsmilj\u00f8 - Konfigurasjonsmal

# MySQL-databasekonfigurasjon (lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ditt_lokale_mysql_passord
DB_NAME=ditt_databasenavn

# Krypteringsn\u00f8kkelkonfigurasjon
# Generer med: openssl rand -base64 32 (Linux/macOS/WSL)
MESSAGE_ENCRYPTION_KEY=din_base64_krypteringsnøkkel_her

# Datalagringsperiode (dager)
RESERVATION_RETENTION_DAYS=1


# Konfigurasjon for Backend-server
BACKEND_HOST=localhost
BACKEND_PORT=3001

# Konfigurasjon for Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
